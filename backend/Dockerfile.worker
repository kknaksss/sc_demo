# worker — open-kknaks ClaudeWorker (SC-SPEC-05 §3 host 의존성, SC-WP-01 C5).
#
# claude CLI 박는 방식 (매디니스 prod 패턴 차용 — back/Dockerfile.worker + compose.prod worker):
# - 컨테이너에는 **node 만** 설치하고 Claude Code 는 설치하지 않는다.
# - host 의 claude 디렉토리(`bin/claude` + `lib/`)를 `:ro` 바인드마운트(compose) + PATH 우선
#   → 컨테이너 node 가 마운트된 host claude 바이너리를 실행한다.
# - 인증 = `CLAUDE_CODE_OAUTH_TOKEN`(compose env_file=.env, 레포 커밋 금지).
# - root 로 실행(마운트한 host 디렉토리 권한 회피).
#
# backend(API) 이미지와 분리한다 — API 는 node 불필요, worker 만 node + host claude 마운트.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

# node 20 — claude CLI 런타임(바이너리 자체는 host 에서 마운트). claude code 는 설치하지 않음.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# uv (의존성 관리) — backend Dockerfile 과 동일하게 astral 이미지에서 바이너리만 복사.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# 의존성 레이어 (소스 변경과 분리해 캐시). vendor/ 의 open-kknaks wheel 은
# [tool.uv.sources] path 참조라 sync 전에 있어야 한다(C4 와 동일 wheel 재사용).
COPY pyproject.toml uv.lock* ./
COPY vendor/ ./vendor/
RUN uv sync --no-dev --no-install-project

# 앱 소스.
COPY . .

# worker 는 마이그레이션을 돌리지 않는다(backend 단일 owner, SC-SPEC-05 §4) — entrypoint 없이 바로 기동.
CMD ["python", "-m", "app.worker"]
