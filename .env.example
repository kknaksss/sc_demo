# sc_demo 환경변수 예시 — 복사해서 `.env`(dev) / `.env.prod`(prod) 로 쓴다(둘 다 gitignore, 커밋 금지).
#   dev:  cp .env.example .env       → docker compose up -d --build
#   prod: cp .env.example .env.prod  → docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
# docker compose 가 이 디렉토리의 env 파일을 로드한다(변수 치환 + worker env_file).

# ── worker claude: .claude-tools 마운트 (SC-WP-01 C5) ──
# worker 컨테이너에 claude 를 설치하지 않는다. `bash setup.sh` 가 Linux node + Claude Code(JS) 를
# .claude-tools/ 에 스테이징하고, compose 가 :ro 마운트 + PATH(/claude-tools/node/bin, /claude-tools/node_modules/.bin)에 우선순위로 넣는다.
# JS(claude)는 플랫폼무관 + node 는 Linux판 → Mac/Linux host 양쪽에서 컨테이너가 claude 를 실행한다.
# (선행: `bash setup.sh` 1회 — .claude-tools 생성)

# Claude Code OAuth 토큰 — worker 의 claude 인증. **절대 커밋 금지.** host 에서 `claude setup-token`.
# worker 서비스의 env_file 로만 주입된다(compose environment 에 박으면 안 됨).
CLAUDE_CODE_OAUTH_TOKEN=

# ── postgres ──
POSTGRES_USER=sc_demo
POSTGRES_PASSWORD=sc_demo
POSTGRES_DB=sc_demo
