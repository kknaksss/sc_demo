# sc_demo 환경변수 예시 — 복사해서 `.env` 로 쓴다(`.env` 는 gitignore, 커밋 금지).
#   cp .env.example .env  후 값 채우기.
# docker compose 가 이 디렉토리의 `.env` 를 자동 로드한다(변수 치환 + worker env_file).

# ── worker: host claude CLI 인증/바인드마운트 (SC-WP-01 C5, SC-SPEC-05 §3) ──
# worker 컨테이너는 claude 를 설치하지 않고 host 바이너리를 :ro 마운트해서 쓴다.

# host claude 부모 디렉토리의 **절대경로**. `bin/claude` 와 `lib/`(node_modules) 를 모두 포함해야 한다
# (bin/claude 는 lib/ 를 가리키는 symlink). compose 가 이 경로를 컨테이너에 동일 경로로 :ro 마운트하고
# PATH(${CLAUDE_BIN_DIR}/bin)에 우선순위로 넣는다.
#   - deploy(Linux): npm 전역 설치 위치(예: /home/kknaks/.local)
#   - dev(Mac): host claude 가 Mac 바이너리면 Linux 컨테이너에서 exec format error → 실행 불가(C5 한계 노트 참조)
# 미설정 시 compose 기본값 /root/.local (사실상 claude 없음 → provider.check 실패).
CLAUDE_BIN_DIR=/home/kknaks/.local

# Claude Code OAuth 토큰 — worker 의 claude 인증. **절대 커밋 금지.**
# worker 서비스의 env_file(.env)로만 주입된다(compose environment 에 박으면 안 됨).
CLAUDE_CODE_OAUTH_TOKEN=

# ── postgres (compose 기본값 있음 — 바꿀 때만 설정) ──
# POSTGRES_USER=sc_demo
# POSTGRES_PASSWORD=sc_demo
# POSTGRES_DB=sc_demo
